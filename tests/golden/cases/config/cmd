# workspace is the one key; the local file lives in the checkout, the global
# one under the config home, and show reports which one won.
@sh mkdir -p .git
krowk config show
krowk config set workspace ws_local
krowk config show
@ls {work}
@cat {work}/.krowk/config.json
krowk config set workspace ws_global --global
krowk config show
@ls {home}
krowk config unset workspace
krowk config show
krowk config unset workspace --global
krowk config show --format human
krowk config set bogus_key 1
@env KROWK_WORKSPACE=ws_env
krowk config show
