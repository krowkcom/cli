# CI and agent environments name the run's context without a checkout.
@registry
@env KROWK_TOKEN=krowk_sk_test
@file a.txt hello
@env GITHUB_ACTIONS=true
@env GITHUB_REPOSITORY=krowkcom/golden
@env GITHUB_SHA=0123456789abcdef0123456789abcdef01234567
@env GITHUB_REF=refs/pull/42/merge
@env GITHUB_REF_NAME=42/merge
@env GITHUB_HEAD_REF=feature/x
@env GITHUB_REF_TYPE=branch
@env GITHUB_SERVER_URL=https://github.com
@env GITHUB_RUN_ID=999
krowk push a.txt --jq '.data.artifacts[0].metadata'
krowk push a.txt --jq '.data.run.metadata'
@env CLAUDECODE=1
@env CLAUDE_CODE_SESSION_ID=sess-123
@env ANTHROPIC_MODEL=claude-opus-5
krowk push a.txt --jq '.data.artifacts[0].metadata'
@unenv CLAUDECODE
@unenv CLAUDE_CODE_SESSION_ID
@unenv ANTHROPIC_MODEL
@env CURSOR_TRACE_ID=trace-1
krowk push a.txt --jq '.data.artifacts[0].metadata'
@env KROWK_AGENT=my-agent
@env KROWK_MODEL=gpt-5.5
@env KROWK_SESSION=s-9
krowk push a.txt --jq '.data.artifacts[0].metadata'
krowk push a.txt --jq '.data.run.metadata'
krowk doctor
