# On a terminal the human format is the default and output is coloured; the
# spinner draws on the same terminal while bytes move.
@registry
@file a.txt hello
@file shot.png \x89PNG\r\n\x1a\n0000
@tty krowk push a.txt
@tty krowk push a.txt shot.png
@tty krowk push a.txt --json
@tty krowk push missing.txt
@tty krowk bogus
@tty krowk doctor
@tty krowk config show
