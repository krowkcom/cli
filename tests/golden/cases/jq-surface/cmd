# --jq over a record that needs no registry: the help catalog. What gojq
# does is the contract — formats, key order, numbers JSON cannot spell.
krowk help --jq '.name'
krowk help --jq '[.commands[].name] | @csv'
krowk help --jq '[.commands[].name] | @tsv'
krowk help --jq '[.global_flags[] | [.name, .type]] | .[] | @csv'
krowk help --jq '.environment[0] | to_entries[0].key'
krowk help --jq '.environment[0] | keys'
krowk help --jq '.environment[0] | [.[] | type]'
krowk help --jq '[.environment[0] | paths]'
krowk help --jq '.environment[0] | tojson'
krowk help --jq '[.commands[0].args[0] | tostream]'
krowk help --jq '[nan, infinite, -infinite, 1.5e300 * 1e10]'
krowk help --jq '.commands | length'
krowk help --jq '[.commands[] | select(.subcommands) | .name]'
krowk help --jq '.commands[0].name | ascii_upcase'
krowk help --jq '.commands[0].name | test("pu")'
krowk help --jq '.name | @base64'
krowk help --jq '[limit(2; .commands[].name)]'
krowk help --jq '.commands[0] | has("usage")'
krowk help --jq '.name | tonumber'
krowk help push --jq '.flags | map(.name) | join(",")'
krowk help --jq 'halt_error'
krowk help --jq '(.commands | length) / 2'
krowk help --jq '[10/2, 5*1.0, 1e17, 0.5, 1e21, 1e-7]'
krowk help --jq '"\([.commands[0].name, 1] | @csv)"'
krowk help --jq '.commands[0] | @csv "row: \([.name, .usage])"'
